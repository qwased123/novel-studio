{
  "name": "novel-memory-system",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch src/main.ts\" \"vite --host 127.0.0.1 --port 5188\"",
    "dev:api": "tsx watch src/main.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5188",
    "build": "tsc -p tsconfig.json && vite build",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node dist/src/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "benchmark": "tsx src/benchmark-cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^10.1.2",
    "@vitejs/plugin-react": "^5.0.2",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
